# API Gateway Configuration

PORT=8000

# JWT - must match the backend's JWT_SECRET
JWT_SECRET=console_shop_secret
JWT_REFRESH_SECRET=console_shop_refresh

# Upstream service URLs (internal Kubernetes service names in production)
BACKEND_URL=http://localhost:3012
PAYMENT_GATEWAY_URL=http://localhost:8080

# Rate limiting
RATE_LIMIT=100               # requests per window
RATE_WINDOW_SECONDS=60       # window size in seconds
RATE_BURST_SIZE=20           # burst allowance

# File upload limits
MAX_FILE_SIZE_MB=10          # per-file max size in MB
MAX_FILE_COUNT=5             # max files per request

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3022,http://localhost:3030,https://localhost:3022

# Internal secret shared between gateway and downstream services
INTERNAL_SECRET=internal-secret-change-me-in-production

# Deployment zone — local | dev | prod
ZONE=local
